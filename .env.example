APP_NAME="Product API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST=pgsql resolve pelo nome do serviço no docker-compose. Rodando
# localmente sem Docker, troque para 127.0.0.1 (ou o host do seu Postgres).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=product_api
DB_USERNAME=product_api
DB_PASSWORD=product_api

# Portas que o docker-compose expõe no host. Só relevantes para o modo
# Docker; ajuste se já tiver algo ocupando 8000/5432/9200 na sua máquina.
APP_FORWARD_PORT=8000
DB_FORWARD_PORT=5432
ELASTICSEARCH_FORWARD_PORT=9200

# Busca full-text (diferencial, opcional). ELASTICSEARCH_HOST=elasticsearch
# resolve pelo docker-compose; localmente, aponte para 127.0.0.1:9200 (ou
# deixe em branco/indisponível — só o endpoint GET /products/search depende
# disso, o resto da API funciona normalmente sem o Elasticsearch no ar).
ELASTICSEARCH_HOST=elasticsearch:9200
PRODUCTS_SEARCH_INDEX=products

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# database mantém o worker de fila funcional em Docker e local sem
# depender de Redis/SQS.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

L5_SWAGGER_GENERATE_ALWAYS=true
